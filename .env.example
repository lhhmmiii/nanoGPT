# ── Model ─────────────────────────────────────────────────────────────────────
# "gpt2" | "gpt2-medium" | "gpt2-large" | "gpt2-xl"
MODEL_TYPE=gpt2

# Optional: path to a local .pt checkpoint (leave blank to use HuggingFace weights)
# CHECKPOINT_PATH=/path/to/checkpoint.pt

# ── KV Cache ──────────────────────────────────────────────────────────────────
NUM_KV_BLOCKS=512

# ── Generation defaults ───────────────────────────────────────────────────────
DEFAULT_MAX_NEW_TOKENS=200
DEFAULT_TEMPERATURE=1.0
DEFAULT_TOP_K=50

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
